gametitle=Ys V - Lost Kefin, Kingdom of Sand (English 1.1) (NTSC-J) SLPM-66360 09F7E99D

[No-Interlacing]
author=heavyjam
description=Forces progressive output (SMODE2 INT=0) and removes the per-field half-line offset. Game logic still believes it is interlaced, which it requires to boot.
gsinterlacemode=1
// display env builder (sceGsSetDefDispEnv): SMODE2 value for interlaced FRAME mode 3 -> 2 (INT=0)
patch=1,EE,00100694,word,24020002
// same builder: SMODE2 value for interlaced FIELD mode 1 -> 0 (unused mode, for safety)
patch=1,EE,00100698,word,24020000
// same builder, NTSC FRAME DISPLAY path: DH = height-1 (224 lines) instead of 2*height-1 (448)
patch=1,EE,0010073C,word,02401021
// main render loop: force field argument of sceGsSetHalfOffset to 0 (no alternating half-pixel Y offset)
patch=1,EE,00187234,word,0000382D
// boot loader render loop: same half-offset neutralization
patch=1,EE,00135898,word,0000382D
// per-object render dispatch: field parity argument forced to 0 so the world/camera
// renderer stops alternating its half-line offset each field (fixes vertical bobbing)
patch=1,EE,00188940,word,0000902D
